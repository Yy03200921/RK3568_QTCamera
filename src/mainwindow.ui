  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget#centralWidget, QWidget#cameraPage,
QWidget#photoPage {
    background: #080a0d;
    color: #f5f7fa;
    font-family: "Noto Sans CJK SC", "Source Han Sans CN", sans-serif;
}
QStackedWidget#pageStack {
    background: #080a0d;
    border: none;
}
QFrame#controlPanel, QFrame#photoTopBar {
    background: #15181d;
}
QFrame#controlPanel {
    border-left: 1px solid #2a2f37;
}
QFrame#photoTopBar {
    border-bottom: 1px solid #2a2f37;
}
QLabel#brandLabel {
    color: #ffffff;
    font-size: 19px;
    font-weight: 700;
}
QLabel#statusLabel, QLabel#previewPhotoNameLabel {
    color: #aeb6c2;
    font-size: 13px;
}
QLabel#previewLabel, QLabel#photoPreviewLabel {
    background: #000000;
    border: none;
}
QPushButton#shutterButton {
    min-width: 96px;
    max-width: 96px;
    min-height: 96px;
    max-height: 96px;
    border-radius: 48px;
    border: 8px solid #858d98;
    background: #ffffff;
}
QPushButton#shutterButton:pressed {
    border-color: #c9d0d8;
    background: #d9dee4;
}
QPushButton#shutterButton:disabled {
    border-color: #40464f;
    background: #707780;
}
QPushButton#startStopButton, QPushButton#exitButton,
QPushButton#backButton {
    min-height: 54px;
    border: 1px solid #3a414b;
    border-radius: 6px;
    background: #242931;
    color: #f5f7fa;
    font-size: 15px;
    font-weight: 600;
}
QPushButton#startStopButton:pressed, QPushButton#exitButton:pressed,
QPushButton#backButton:pressed {
    background: #343b45;
}
QPushButton#thumbnailButton {
    min-width: 144px;
    max-width: 160px;
    min-height: 81px;
    max-height: 90px;
    background: #050607;
    border: 1px solid #3a414b;
    border-radius: 5px;
    color: #8e98a5;
    font-size: 12px;
}
QPushButton#thumbnailButton:pressed {
    border-color: #ffffff;
}
QLabel#photoNameLabel {
    color: #8e98a5;
    font-size: 11px;
}</string>
